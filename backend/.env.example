# Copy this file to .env (same folder as main.py) and fill in whichever
# channels you want to turn on. Nothing here is required — the app works
# fully with zero config, just printing notifications to the console
# instead of actually sending them externally.
#
# IMPORTANT: the file must be named exactly `.env` and live in
# backend/ (next to main.py) — python-dotenv only auto-loads that
# specific name/location. After editing it, restart `uvicorn` (env
# vars are only read once, at process startup — editing .env while the
# server is already running has no effect until you restart it).
#
# In-app notifications and Web Push (browser push) already work for
# real with ZERO configuration below — no account needed for either.

# ---- Core / deployment ----
# All optional for local development — everything below defaults to
# the zero-config local setup (SQLite file, permissive CORS, dev JWT
# fallback) if left unset.

# Unset (default): a SQLite file in this folder. Set to a real
# Postgres URL to use that instead — docker-compose.yml sets this
# automatically for the containerized setup.
# DATABASE_URL=postgresql://user:password@localhost:5432/delivery_sync

# "development" (default) or "production". Production tightens real
# safety behavior, not just logging — see main.py / services/auth.py
# for specifics: hides the interactive /docs API explorer, requires
# ALLOWED_ORIGINS to be set explicitly (no wide-open CORS default),
# and refuses to start at all if JWT_SECRET_KEY is still unset.
# ENVIRONMENT=production

# Comma-separated list of exact frontend URLs allowed to call this API.
# REQUIRED if ENVIRONMENT=production; ignored (defaults to allow-all)
# in development.
# ALLOWED_ORIGINS=https://your-real-frontend.example.com

# A long, random signing key for login tokens — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED if ENVIRONMENT=production (the app won't start without it).
# JWT_SECRET_KEY=

# ---- Email (SMTP) ----
# Works with any SMTP provider. Easiest free option: a Gmail account
# with an "App Password" (Google Account -> Security -> App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
FROM_EMAIL=youraddress@gmail.com

# ---- SMS + WhatsApp (Twilio) ----
# Sign up free at twilio.com — the trial account includes real credit,
# enough to fully test both SMS and WhatsApp at zero cost.
# SMS: buy/use your trial Twilio phone number for TWILIO_FROM_NUMBER.
# WhatsApp: join Twilio's free WhatsApp Sandbox (Console -> Messaging ->
# Try it out -> Send a WhatsApp message) — no Meta business approval
# needed for this sandbox tier. Its number is always +14155238886.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Web Push (VAPID) ----
# Optional — a working default keypair is already built in, so push
# notifications work out of the box. Only set these if you want your
# own keys (recommended before any real multi-user deployment, so you
# aren't sharing a key with every other clone of this project).
# Generate with: pip install py-vapid && vapid --gen
#
# IMPORTANT: leave the next two lines commented out (as below) unless
# you're actually setting a real key. Uncommenting them with nothing
# after the `=` sets an EMPTY value, which is not the same as leaving
# the setting out entirely — an empty VAPID key breaks push
# notifications outright ("applicationServerKey is not valid") instead
# of falling back to the working built-in default.
# VAPID_PRIVATE_KEY_PEM=
# VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

FRONTEND_URL=http://localhost:3500
# Used to build links in emails (e.g. the password reset link). MUST
# match the port your frontend dev server actually runs on — this
# project's frontend/vite.config.js sets it to 3500, NOT Vite's own
# default of 5173, so if you see "site can't be reached" after
# clicking a reset-password link, this is almost always why: check
# what port `npm run dev` printed and match it here.

# ---- Bot protection (Google reCAPTCHA v2) ----
# Register a site free at google.com/recaptcha/admin (~2 minutes, no
# billing account needed) — choose reCAPTCHA v2 "Checkbox". Without
# this set, signup and forgot-password still work exactly as before —
# the CAPTCHA check is simply skipped (see backend/app/services/captcha.py).
# Also set VITE_RECAPTCHA_SITE_KEY in frontend/.env.example (from the
# SAME site registration) so the widget actually renders — the backend
# check and the frontend widget are independent, but only useful together.
# RECAPTCHA_SECRET_KEY=

# ---- Payments (Razorpay) ----
# Sign up free at dashboard.razorpay.com (no KYC needed for Test Mode,
# ~5 minutes). Settings -> API Keys -> Generate Test Key.
# Without these set, checkout still works end-to-end (cart, address,
# order, delivery creation, notifications) but the payment step itself
# is a clearly-labeled local stand-in instead of a real gateway call —
# see backend/app/services/payment.py for exactly how and why.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# ---- Reverse Geocoding (agent "coverage area" from GPS) ----
# Optional — a free provider (OpenStreetMap Nominatim) is used by
# default with zero setup. Set this to use Google's Maps Geocoding API
# instead, which generally has more complete/accurate address data.
# Needs a Google Cloud project with billing enabled and the "Geocoding
# API" turned on (console.cloud.google.com) — Google's free monthly
# credit comfortably covers normal usage for a project this size.
# NOTE: this only affects turning a GPS coordinate into an address —
# it does NOT make the coordinate itself more accurate. Raw location
# accuracy is determined by the requesting device's own GPS/WiFi/OS
# location services (see services/geocoding.py's docstring).
# GOOGLE_MAPS_API_KEY=

# ---- Sign in with Google (staff AND customer SSO) ----
# Register free at console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID (type: Web
# application). Add BOTH of this backend's callback URLs under
# "Authorized redirect URIs" — for local dev that's
# http://localhost:8000/auth/oauth/google/callback (staff) AND
# http://localhost:8000/customer/oauth/google/callback (customer).
# Only GOOGLE_REDIRECT_URI below is configurable — the customer
# callback path is fixed at /customer/oauth/google/callback on the
# same host, so it never needs its own env var; just add it as a
# second entry in Google Cloud Console.
# Without these set, "Sign in with Google" simply doesn't appear on
# the login/signup pages (staff or customer) and the underlying
# endpoints return a clear 400 rather than a broken redirect — see
# backend/app/services/oauth.py.
# Note: this is a DIFFERENT Google Cloud project/credential type from
# GOOGLE_MAPS_API_KEY above (Maps Geocoding API key vs. OAuth client
# ID) — the two are unrelated and independently optional.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# ---- Automated database backups ----
# Both optional — sensible defaults apply if left unset. A real backup
# (SQLite file copy, or pg_dump against Postgres — see
# backend/app/services/backup.py) runs automatically on this interval,
# with old backups pruned down to this count right after (see
# services/backup_scheduler.py). An admin can still trigger one
# manually anytime from the Monitoring dashboard regardless of this
# schedule. Not started at all while running the test suite (TESTING=1).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=7

# ---- "Try the Demo" ----
# POST /auth/demo-login (a "Try the Demo" button on the login page)
# logs anyone straight into a real, pre-populated dispatcher account —
# no signup, no password. It's a single SHARED sandbox organization
# (see backend/app/services/demo_seed.py's own module docstring for
# why), reset back to its known-good seeded state on this interval so
# it doesn't stay broken after visitors explore it. Optional — a
# sensible default applies if left unset.
# DEMO_RESET_INTERVAL_HOURS=6
